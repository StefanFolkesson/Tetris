<Window x:Class="Tetris.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tetris"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="600">
    <StackPanel Height="850px" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Height="100px" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Top">
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <!-- Left column -->
            <StackPanel Width="150" Background="LightGray">
                <Label x:Name="ScoreLabel" Content="Score: 0" FontSize="16" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                
                <!-- Add left-side controls here -->
            </StackPanel>

            <!-- Center canvas -->
            <Canvas x:Name="GameCanvas" Width="300" Height="600" Background="Black" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Right column -->
            <StackPanel Width="150" Background="LightGray">
                <Canvas x:Name="NextPieceCanvas" Width="100" Height="100" Background="White" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <!-- Add right-side controls here -->
            </StackPanel>
        </StackPanel>
        <StackPanel Height="100px" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Button x:Name="StartButton" Content="Start" Width="100" Height="50" Margin="10" Click="StartButton_Click"/>
            
        </StackPanel>
    </StackPanel>
</Window>
